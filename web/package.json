{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "egg": "scripts/egg-cli.mjs"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "setup": "node scripts/setup.mjs",
    "egg": "node scripts/egg-cli.mjs",
    "doctor": "node scripts/doctor.mjs",
    "service:install": "node scripts/service/install.mjs install",
    "service:remove": "node scripts/service/install.mjs remove",
    "worker": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json worker/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "typecheck": "next typegen && tsc --noEmit",
    "docs:generate": "tsx --tsconfig tsconfig.json scripts/generate-docs-markdown.ts",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "compose:up": "docker compose -f ../compose.yaml --project-directory .. up -d --build",
    "backup": "sh ../deploy/backup.sh",
    "fake-nest": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/fake-nest.ts",
    "seed:demo": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/seed-demo.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@libsql/client": "^0.18.0",
    "@phosphor-icons/react": "^2.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "d3-array": "3.2.4",
    "d3-geo": "3.1.2",
    "d3-sankey": "0.12.3",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "driver.js": "1.12.1",
    "drizzle-orm": "^0.45.4",
    "geoip-country": "5.0.202611110258",
    "jose": "^6.2.15",
    "motion": "12.27.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ssh2": "^1.17.0",
    "tar": "^7.5.22",
    "topojson-client": "3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/d3-array": "3.2.1",
    "@types/d3-geo": "3.1.1",
    "@types/d3-sankey": "0.12.5",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.6",
    "@types/geojson": "7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.6",
    "@types/topojson-client": "3.1.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.20.0"
}
