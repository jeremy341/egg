# Copy to .env.local, or run `pnpm setup` to generate one.
# The full guide for running Egg on your own computer is docs/selfhost/README.md.
APP_SECRET=            # 32+ random characters, encrypts SSH keys and env vars. Back it up.
APP_URL=http://localhost:3000
DATABASE_URL=file:./data/egg.db

# Self-hosting on your own computer: sign in without an external account.
# Off unless you set it. Refused when APP_URL is not localhost or 127.0.0.1,
# unless you also set LOCAL_MODE_ALLOW_REMOTE=1 (only behind your own access control).
LOCAL_MODE=0           # 1 = "Sign in on this computer", works in a production build
LOCAL_MODE_ALLOW_REMOTE=0

# Client addresses for rate limits. Off: X-Forwarded-For and X-Real-IP are ignored, so address-based
# limits (sign-in, bad tokens) do not apply. Set to 1 only when every request comes through a reverse
# proxy you run that sets X-Forwarded-For itself; otherwise anyone can pick their own address.
TRUST_PROXY=0

DEV_LOGIN=0            # 1 = fake sign-in, `pnpm dev` only (ignored in a production build)

HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

RUN_WORKER=1            # 1 = web app also runs the queue; 0 = use `pnpm worker`
BUILD_RUNNER=docker    # docker | local (local = no isolation, run only code you trust)
BUILD_TIMEOUT_SECONDS=900
DEPLOY_WORK_DIR=./data/work

# Optional, defaults shown. Leave commented unless you need them.
# BUILD_IMAGE_NODE=node:22-bookworm
# BUILD_IMAGE_PYTHON=python:3.12-bookworm
# NEST_HOST=hackclub.app
# NEST_PORT=22
# UNIT_DIR=/etc/systemd/system
# WORKER_CONCURRENCY=2          # read by the worker, not by config.ts
# MONITOR_INTERVAL_MS=300000    # 0 turns the uptime monitor off
