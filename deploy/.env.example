# Settings for running Egg on your own server with Docker Compose.
# Copy this file to .env in the repository root (next to compose.yaml) and edit it:
#   cp deploy/.env.example .env
# Do not put comments after a value on the same line, and never commit .env.
# Names match web/src/server/config.ts. Read docs/selfhost/README.md for the full guide.

# --- Address and secret ---------------------------------------------------

# The public address people use. Must start with https:// for a real server.
APP_URL=https://egg.example.com
# The host part of APP_URL, without https://. Caddy gets the certificate for this name.
APP_HOST=egg.example.com
# 32 or more random characters. Encrypts SSH keys and project variables.
# Make one with: openssl rand -base64 32
# Back it up. Without it the saved keys and variables in the database cannot be read.
APP_SECRET=

# --- Storage --------------------------------------------------------------

# Absolute folder on this server that holds the database and the cloned source files.
# Create it before the first start and give it to the container user (uid 1000):
#   sudo mkdir -p /srv/egg/data && sudo chown -R 1000:1000 /srv/egg/data
EGG_DATA_DIR=/srv/egg/data
# Inside the containers the data folder is /data.
DATABASE_URL=file:/data/egg.db

# --- Reverse proxy --------------------------------------------------------

# 1 because every request comes through Caddy, which sets X-Forwarded-For itself.
# Never set this to 1 if the app port can be reached without going through Caddy.
TRUST_PROXY=1

# --- Sign-in --------------------------------------------------------------

HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=

# --- GitHub app (leave empty to run without GitHub) -----------------------

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# One line, with \n in place of each line break.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Optional -------------------------------------------------------------

# WORKER_CONCURRENCY=2
# MONITOR_INTERVAL_MS=300000
# MONITOR_CONCURRENCY=4
# NEST_HOST=hackclub.app
# NEST_PORT=22
# Optional private vulnerability inbox: exact Egg database user id of its administrator.
# Leave empty to disable submissions. Never use an email/name as the identity.
SECURITY_REPORT_ADMIN_ID=
